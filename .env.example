# Public site origin (no trailing slash). Local: http://localhost:3000 — required for OAuth redirect_uri, checkout returnUrl, and “open kit app” links.
NEXT_PUBLIC_APP_URL=

# Same experience id as in your Whop app URL path: /experiences/<THIS_VALUE>
NEXT_PUBLIC_WHOP_EXPERIENCE_ID=

# Embedded checkout plan ids (from Whop → Checkout links → plan id). Must grant the same access as your product IDs below.
NEXT_PUBLIC_WHOP_STARTER_PLAN_ID=
NEXT_PUBLIC_WHOP_PRO_PLAN_ID=

# OAuth client id (usually same as WHOP_APP_ID / app_xxx). Register redirect: <NEXT_PUBLIC_APP_URL>/api/auth/whop/callback
NEXT_PUBLIC_WHOP_APP_ID=

# Optional: company id for OAuth authorize (see Whop OAuth docs).
# WHOP_OAUTH_COMPANY_ID=

# Public marketing site — optional fallback “Buy on Whop.com” links (https checkout URLs).
NEXT_PUBLIC_WHOP_STARTER_URL=
NEXT_PUBLIC_WHOP_PRO_URL=

# Server-only kit delivery (never NEXT_PUBLIC_). From Whop dashboard → Developer / API.
WHOP_API_KEY=
WHOP_APP_ID=

# OAuth client secret for /api/auth/whop/callback token exchange (same Whop app as NEXT_PUBLIC_WHOP_APP_ID).
WHOP_CLIENT_SECRET=

# Secret for signing the post-OAuth kit session cookie (random string, 32+ chars).
WHOP_KIT_SESSION_SECRET=

# Product IDs used to decide Starter vs Pro HTML after purchase (Whop product IDs).
WHOP_PRO_PRODUCT_ID=
WHOP_STARTER_PRODUCT_ID=

# Whop embedded app URL should be:
#   https://codybnxthehond.co.za/experiences/<YOUR_EXPERIENCE_ID>
# Match <YOUR_EXPERIENCE_ID> to the experience configured for your app in Whop.

# Local-only: when true (and not a production build), marketing site shows "Dev: Skip to Product"
# and `/experiences/...` can mock access with `?dev_kit_tier=starter` or `pro`. Never enable in production.
NEXT_PUBLIC_DEV_BYPASS_PAYMENT=
# Optional: experience segment for dev skip links (defaults to dev-local-experience).
NEXT_PUBLIC_DEV_BYPASS_EXPERIENCE_ID=

# When true, /kits/creator-starter.html and /kits/creator-pro.html serve publicly (not only in NODE_ENV=development).
# Use for client demos on staging; leave unset in production if you do not want the HTML kits linkable without purchase.
# NEXT_PUBLIC_ENABLE_KIT_HTML_PREVIEW=true

# Optional overrides (paths must stay under content/kits/).
# KIT_HTML_PATH_PRO=content/kits/creator-pro.html
# KIT_HTML_PATH_STARTER=content/kits/creator-starter.html
